# ---------------------------------------------------------------------------
# CardioSaarthi -- demonstration configuration.
#
# Copy this file to .env at the repository root. These values are for a laptop
# running the demo locally and nothing else: the database port is bound to
# 127.0.0.1, and the four-digit demo logins below must never be enabled on a
# machine other people can reach.
#
# No API key is needed to run the demo. The case narratives were generated once
# and are already in the database dump, so nothing calls a model at run time.
# ---------------------------------------------------------------------------

POSTGRES_DB=cardiosaarthi
POSTGRES_USER=cardiosaarthi
POSTGRES_PASSWORD=cardio-demo-local-only
# 55432 rather than 5432, so an existing PostgreSQL install on the laptop keeps
# working and does not have to be stopped for the demo.
POSTGRES_PORT=55432

CARDIO_DATABASE_URL=postgresql://cardiosaarthi:cardio-demo-local-only@127.0.0.1:55432/cardiosaarthi
CARDIO_JDBC_URL=jdbc:postgresql://127.0.0.1:55432/cardiosaarthi

# 8090 rather than 8080: Docker Desktop's WSL relay commonly holds 8080.
REVIEW_API_PORT=8090

# At least 32 characters, or the service refuses to start -- HS256 with a short
# key is a guessable signature rather than a small weakness. Change it if you
# like; any 32+ character string works for a local demo.
CARDIO_JWT_SECRET=cardiosaarthi-demo-signing-key-change-me-please

# The four-digit logins used on stage: faculty TE/1234 and student TE/4321,
# password 1234 for both. The 12-character minimum still applies to every
# account created through the API; this flag is the only exception and it
# defaults to false everywhere else.
CARDIO_DEMO_ACCOUNTS=true

# Left empty on purpose. Scenario generation is not exercised during the demo.
CARDIO_LLM_API_KEY=
CARDIO_LLM_BASE_URL=
CARDIO_LLM_MODEL=

# No extra administrator. The accounts in the restored database are enough.
CARDIO_BOOTSTRAP_EMAIL=
CARDIO_BOOTSTRAP_NAME=
CARDIO_BOOTSTRAP_PASSWORD=
