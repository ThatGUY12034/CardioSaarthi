# Copy to .env and change the password. Development only — the database port is
# bound to 127.0.0.1 in docker-compose.yml and is not reachable off this machine.
POSTGRES_DB=cardiosaarthi
POSTGRES_USER=cardiosaarthi
POSTGRES_PASSWORD=change-me-before-first-run
# 55432 rather than 5432: a PostgreSQL install already owns the default port on
# this machine, and taking it over would break whatever depends on it.
POSTGRES_PORT=55432

# Used by scripts/ingest_cases.py. Kept as one URL so the Python side and the
# Spring Boot side cannot disagree about which database they are pointing at.
CARDIO_DATABASE_URL=postgresql://cardiosaarthi:change-me-before-first-run@127.0.0.1:55432/cardiosaarthi

# JDBC form of the same database, for the Spring Boot service. The two must
# always point at the same place.
CARDIO_JDBC_URL=jdbc:postgresql://127.0.0.1:55432/cardiosaarthi

# The one administrator created when review-api starts, so there is something to
# log in as on a fresh install. Leave empty and nothing can log in, which is the
# right default for a service nobody has configured. Manage real faculty
# accounts through the API, not here.
CARDIO_BOOTSTRAP_EMAIL=
CARDIO_BOOTSTRAP_NAME=
CARDIO_BOOTSTRAP_PASSWORD=

# Port for the review API. 8090 rather than 8080 because Docker Desktop's WSL
# relay commonly holds 8080 on Windows.
REVIEW_API_PORT=8090
